  {
    "rule": {
      "id": 1,
      "name": "Work Mode - Auto Mute & Office Wi-Fi",
      "description": "Automatically silences device and connects to office Wi-Fi during work hours when arriving at the workplace.",
      "isEnabled": true,
      "isPremium": false
    },
    "triggers": [
      {
        "id": 1,
        "ruleId": 1,
        "triggerType": "LOCATION_GEOFENCE",
        "parametersJson": "{\"latitude\":37.7891,\"longitude\":-122.4014,\"radiusMeters\":150,\"transitionType\":\"ENTER\"}",
        "isEnabled": true
      }
    ],
    "conditions": [
      {
        "id": 1,
        "ruleId": 1,
        "conditionType": "TIME_RANGE",
        "parametersJson": "{\"startHour\":9,\"startMinute\":0,\"endHour\":18,\"endMinute\":0,\"daysOfWeek\":[2,3,4,5,6]}",
        "logicalOperator": "AND",
        "isEnabled": true,
        "executionOrder": 0
      }
    ],
    "actions": [
      {
        "id": 1,
        "ruleId": 1,
        "actionType": "SET_RINGER_MODE",
        "parametersJson": "{\"mode\":\"VIBRATE\"}",
        "isEnabled": true,
        "executionOrder": 0
      },
      {
        "id": 2,
        "ruleId": 1,
        "actionType": "SET_WIFI",
        "parametersJson": "{\"state\":\"ENABLED\"}",
        "isEnabled": true,
        "executionOrder": 1
      },
      {
        "id": 3,
        "ruleId": 1,
        "actionType": "SHOW_NOTIFICATION",
        "parametersJson": "{\"title\":\"Work Mode Active\",\"message\":\"Device silenced and connected to Office Wi-Fi\"}",
        "isEnabled": true,
        "executionOrder": 2
      }
    ]
  },
